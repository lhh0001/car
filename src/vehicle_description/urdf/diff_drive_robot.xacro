<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_drive_robot">

  <!-- 默认使用实车尺寸；Gazebo 可通过 Xacro 参数覆盖视觉/物理尺寸。 -->
  <xacro:arg name="wheel_radius" default="0.02"/>
  <xacro:arg name="wheel_separation" default="0.13"/>
  <xacro:arg name="wheel_width" default="0.015"/>
  <xacro:arg name="body_length" default="0.20"/>
  <xacro:arg name="body_width" default="0.13"/>
  <!-- 实车雷达相对车体 +X 顺时针约 37.5 度；仿真启动时覆盖为 0。 -->
  <xacro:arg name="lidar_yaw" default="-0.654498469"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_separation" value="$(arg wheel_separation)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
  <xacro:property name="body_length" value="$(arg body_length)"/>
  <xacro:property name="body_width" value="$(arg body_width)"/>
  <xacro:property name="lidar_yaw" value="$(arg lidar_yaw)"/>
  <xacro:property name="body_height" value="0.08"/>
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="pole_height" value="0.15"/>

  <!-- 轮子放置：车身中偏后，左右对称 -->
  <xacro:property name="wheel_x" value="${-body_length/4}"/>
  <xacro:property name="wheel_y" value="${wheel_separation/2}"/>
  <xacro:property name="wheel_z" value="${-body_height/2}"/>

  <xacro:property name="body_mass" value="10"/>

  <!-- ===== 轮子 macro ===== -->
  <xacro:macro name="wheel" params="name prefix x_reflect y_reflect">
    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x_reflect * wheel_x} ${y_reflect * wheel_y} ${wheel_z}" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit effort="50" velocity="20"/>
    </joint>
  </xacro:macro>

  <!-- ===== base_footprint ===== -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + body_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== base_link ===== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="blue"><color rgba="0 0.5 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}"/>
      <!-- ixx = m/12*(y²+z²), iyy = m/12*(x²+z²), izz = m/12*(x²+y²) -->
      <inertia
        ixx="${body_mass/12 * (body_width*body_width + body_height*body_height)}"
        iyy="${body_mass/12 * (body_length*body_length + body_height*body_height)}"
        izz="${body_mass/12 * (body_length*body_length + body_width*body_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== 驱动轮（左右各一） ===== -->
  <xacro:wheel name="left"  prefix="left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel name="right" prefix="right" x_reflect="1"  y_reflect="-1"/>

  <!-- ===== 前万向轮 ===== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"><color rgba="0.4 0.4 0.4 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <surface>
        <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${body_length/2 - 0.02} 0 ${caster_radius - wheel_radius - body_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== 支柱 + LiDAR ===== -->
  <link name="pole">
    <visual>
      <geometry><cylinder radius="0.03" length="${pole_height}"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="${pole_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="pole_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pole"/>
    <origin xyz="0 0 ${body_height/2 + pole_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="pole"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${pole_height/2 + 0.02}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

</robot>
