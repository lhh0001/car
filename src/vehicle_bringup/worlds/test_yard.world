<?xml version="1.0"?>
<sdf version="1.7">
  <world name="test_yard">

    <gravity>0 0 -9.8</gravity>

    <!-- ===== 光照 ===== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ===== 地面 ===== -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 50</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 50</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 围墙 ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 2</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -15 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 2</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>15 0 1 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 2</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 1 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 2</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 障碍物：方块 ===== -->
    <model name="box_1">
      <static>true</static>
      <pose>4 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-3 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
