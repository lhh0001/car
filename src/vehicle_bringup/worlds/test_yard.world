    </model>

    <!-- ===== L 型建筑 ===== -->
    <model name="building_wing_a">
      <static>true</static>
      <pose>10 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 1 3</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.6 1</ambient>
            <diffuse>0.6 0.6 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_wing_b">
      <static>true</static>
      <pose>13 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 7 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 7 3</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.6 1</ambient>
            <diffuse>0.6 0.6 0.7 1</diffuse>
