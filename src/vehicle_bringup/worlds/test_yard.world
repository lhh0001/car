    <model name="pillar_3">
      <static>true</static>
      <pose>-5 7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
