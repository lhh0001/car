<?xml version="1.0"?>
<package format="3">
  <name>vehicle_bringup</name>
  <version>0.1.0</version>
  <description>Top-level scenario composition for the differential-drive robot.</description>
  <maintainer email="lhh@todo.todo">lhh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- vehicle_bringup only composes feature packages. -->
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>vehicle_simulation</exec_depend>
  <exec_depend>vehicle_mapping</exec_depend>
  <exec_depend>vehicle_navigation</exec_depend>
  <exec_depend>vehicle_hardware</exec_depend>
  <exec_depend>lidar_pkg</exec_depend>
  <exec_depend>vehicle_control</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
