<?xml version="1.0"?>
<package format="3">
  <name>vehicle_control</name>
  <version>0.1.0</version>
  <description>Teleoperation and ROS graph diagnostics for the differential-drive robot.</description>
  <maintainer email="lhh@todo.todo">lhh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <!-- graph_monitor.py 需要 PyQt5，非必需 -->
  <exec_depend>python3-pyqt5</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
